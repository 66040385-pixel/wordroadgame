        <svg class="ico" style="width:24px; height:24px;" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        <span>ทำแบบทดสอบปลดล็อกบทเรียน</span>
      </a>
    </div>
  </div>

  <script>
    // คลังเนื้อหาหนังสือเรียนแบบรายละเอียดจัดเต็ม 12 บท (ใช้ Vector SVG Icons ทั้งหมด)
    const bookDatabase = {
