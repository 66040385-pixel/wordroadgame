<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Word Road 3D: หนังสือเรียนดิจิทัล Microsoft Word (ม.1)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,600;0,700;0,800;1,700&family=Kanit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --word-blue-dark: #1e40af;
      --word-blue-main: #1d4ed8;
      --word-blue-bright: #3b82f6;
      --word-cyan: #0284c7;
      --arcade-gold: #f59e0b;
      --arcade-yellow: #facc15;
      --arcade-green: #10b981;
      --arcade-red: #ef4444;
      --bg-gradient: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 50%, #7dd3fc 100%);
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-sub: #334155;
      --text-muted: #475569;
    }

    * {
      box-sizing: border-box; margin: 0; padding: 0;
      user-select: none; -webkit-user-select: none;
      touch-action: manipulation;
    }

    body {
      min-height: 100vh;
      background: var(--bg-gradient);
      font-family: 'Kanit', sans-serif;
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 20px 14px 50px;
      overflow-x: hidden;
      position: relative;
    }

    /* 3D Bright Arcade Grid Background */
    body::before {
      content: ''; position: fixed; inset: 0;
      background: 
        linear-gradient(to right, rgba(2, 132, 199, 0.12) 2px, transparent 2px),
        linear-gradient(to bottom, rgba(2, 132, 199, 0.12) 2px, transparent 2px);
      background-size: 32px 32px;
      pointer-events: none; z-index: 0;
    }

    .ico {
      width: 22px; height: 22px; fill: currentColor;
      display: inline-block; vertical-align: middle; flex-shrink: 0;
    }

    /* Main Container Card */
    .study-container {
      background: var(--card-bg);
      border: 4px solid var(--word-blue-main);
      border-radius: 28px;
      padding: 32px 28px;
      max-width: 880px; width: 100%;
      box-shadow: 0 10px 0 var(--word-blue-dark), 0 20px 40px rgba(2, 132, 199, 0.25);
      text-align: left;
      z-index: 1;
      position: relative;
      animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes popIn {
      from { transform: scale(0.92) translateY(20px); opacity: 0; }
      to { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* Top Navigation Header */
    .top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 3px dashed #bae6fd;
      padding-bottom: 16px;
      margin-bottom: 24px;
      gap: 12px; flex-wrap: wrap;
    }

    .unit-badge-pill {
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: #ffffff;
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 800;
      padding: 8px 20px;
      border-radius: 999px;
      font-size: 1rem;
      box-shadow: 0 4px 0 #1e3a8a;
      display: inline-flex; align-items: center; gap: 8px;
    }

    .btn-back-hub {
      padding: 10px 18px;
      border-radius: 14px;
      border: 2px solid #bae6fd;
      background: #f0f9ff;
      color: var(--word-blue-main);
      font-weight: 800;
      font-size: 0.9rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
      transition: all 0.15s;
      box-shadow: 0 4px 0 #7dd3fc;
    }
    .btn-back-hub:hover { background: #e0f2fe; }
    .btn-back-hub:active { transform: translateY(2px); box-shadow: 0 1px 0 #7dd3fc; }

    /* Lesson Typography */
    .lesson-header-title {
      font-size: 1.65rem;
      font-weight: 900;
      color: var(--word-blue-main);
      line-height: 1.35;
      margin-bottom: 22px;
      border-bottom: 3px solid #e0f2fe;
      padding-bottom: 14px;
      display: flex; align-items: center; gap: 12px;
    }

    .content-section {
      font-size: 1.02rem;
      line-height: 1.85;
      color: var(--text-sub);
      font-weight: 400;
    }

    .content-section h3 {
      color: var(--word-blue-dark);
      font-size: 1.22rem;
      font-weight: 800;
      margin: 28px 0 14px;
      display: flex; align-items: center; gap: 10px;
      border-left: 6px solid var(--word-blue-main);
      padding-left: 14px;
      background: linear-gradient(90deg, #e0f2fe 0%, transparent 100%);
      padding-top: 6px; padding-bottom: 6px; border-radius: 0 12px 12px 0;
    }

    .content-section p { margin-bottom: 14px; text-indent: 1.5em; }
    .content-section p.no-indent { text-indent: 0; }

    .content-section ul, .content-section ol {
      margin-left: 24px;
      margin-bottom: 18px;
    }

    .content-section li {
      margin-bottom: 10px;
    }

    /* Callout & Shortcut Boxes */
    .key-callout-box {
      background: #f0f9ff;
      border: 3px solid #bae6fd;
      border-radius: 22px;
      padding: 22px;
      margin: 24px 0;
      box-shadow: 0 6px 0 #7dd3fc;
    }

    .key-callout-title {
      font-weight: 800;
      color: var(--word-blue-main);
      font-size: 1.05rem;
      margin-bottom: 12px;
      display: flex; align-items: center; gap: 8px;
    }

    .shortcut-badge {
      background: #fef08a;
      color: #713f12;
      border: 2px solid #facc15;
      padding: 3px 10px;
      border-radius: 10px;
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 800;
      font-size: 0.92rem;
      box-shadow: 0 3px 0 #d97706;
      display: inline-block;
      margin: 2px 4px;
    }

    .ui-demo-box {
      background: #ffffff;
      border: 3px dashed #38bdf8;
      border-radius: 22px;
      padding: 22px;
      margin: 24px 0;
      text-align: center;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
    }

    .ui-demo-caption {
      font-size: 0.9rem;
      font-weight: 800;
      color: var(--text-muted);
      margin-top: 12px;
    }

    /* Action Buttons (Hub / Test) */
    .action-footer-group {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 14px;
      margin-top: 36px;
    }

    .btn-action-footer {
      padding: 16px;
      border-radius: 18px;
      border: none;
      font-size: 1.1rem;
      font-weight: 800;
      cursor: pointer;
      display: flex; justify-content: center; align-items: center; gap: 10px;
      text-decoration: none;
      transition: all 0.15s;
    }

    .btn-return-hub {
      background: #e0f2fe;
      color: #0284c7;
      border: 2px solid #38bdf8;
      box-shadow: 0 5px 0 #0284c7;
    }
    .btn-return-hub:hover { background: #bae6fd; }
    .btn-return-hub:active { transform: translateY(3px); box-shadow: 0 1px 0 #0284c7; }

    .btn-start-test {
      background: linear-gradient(180deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      box-shadow: 0 6px 0 #047857, 0 10px 20px rgba(16, 185, 129, 0.3);
    }
    .btn-start-test:hover { filter: brightness(1.06); }
    .btn-start-test:active { transform: translateY(4px); box-shadow: 0 2px 0 #047857; }

    /* Responsive Adjustments for All Devices */
    @media (max-width: 640px) {
      body { padding: 14px 10px 32px; }
      .study-container { padding: 22px 16px; border-radius: 22px; }
      .lesson-header-title { font-size: 1.35rem; }
      .action-footer-group { grid-template-columns: 1fr; }
      .content-section { font-size: 0.96rem; }
      .unit-badge-pill { font-size: 0.88rem; padding: 6px 14px; }
      .btn-back-hub { font-size: 0.85rem; padding: 8px 12px; }
    }
  </style>
</head>
